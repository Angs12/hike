# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Lifts x86-64 ELF binaries to LLVM IR through a value-set analysis"
description:
  "A BAP plugin that lifts x86-64 ELF binaries to LLVM IR.  A vendored value-set analysis attributes every memory access to a section; the stack splits into real LLVM allocas (regions, VLA allocas, the residue fallback), and the emitter renders the program through one seam (bil2llvm) with the semantic harness as the acceptance oracle."
maintainer: ["Angs12"]
authors: ["Angs12"]
homepage: "https://github.com/Angs12/hike"
bug-reports: "https://github.com/Angs12/hike/issues"
depends: [
  "ocaml"
  "dune" {>= "3.23"}
  "bap"
  "llvm"
  "bap-core-theory"
  "bap-future"
  "bap-knowledge"
  "bap-main"
  "bitvec"
  "bin_prot"
  "core"
  "findlib"
  "graphlib"
  "monads"
  "ogre"
  "zarith"
  "unix"
  "ppx_bap" {build}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/Angs12/hike.git"
x-maintenance-intent: ["(latest)"]
