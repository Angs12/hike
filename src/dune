(library
  (name hike)
  (public_name hike)
  (flags
  (:standard
   -alert
   -deprecated
   -w
   +a-4-9-27-29-32-39-40-41-42-44-45-48-58-59-60-70))
  (ocamlopt_flags
  (:standard -O3))
  (preprocess
  (action
   (run %{workspace_root}/src/cppo_preprocess.sh %{profile} %{input-file})))
  (libraries
    str
    unix
    bap
    llvm
    bap-core-theory
    bap-future
    bap-knowledge
    bap-main
    bitvec
    bitvec-order
    core
    core_kernel
    monads
    ogre
    hike.hike_abi
    hike.cbat_vsa
    hike.cbat_vsa_domain))

; Build blocker: fails the build on env reads in src/ or direct prints
; outside Hike_diag / Event.Log. Runs on [dune build] and [@install].
(rule
 (alias all)
 (deps (source_tree .))
 (action
  (run %{workspace_root}/src/check_instrumentation.sh .)))

(rule
 (alias install)
 (deps (source_tree .))
 (action
  (run %{workspace_root}/src/check_instrumentation.sh .)))

; Dune-built bap plugin; installs where bap dynloads plugins from.
(plugin
 (name hike)
 (package hike)
 (libraries hike)
 (site (bap-common plugins)))
