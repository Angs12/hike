(library
  (name hike)
  (public_name hike)
  (preprocess
  (action
   (run %{workspace_root}/src/cppo_preprocess.sh %{profile} %{input-file})))
  (libraries

    unix
    bap
    llvm
    bap-core-theory

    bap-knowledge
    bap-main
    bitvec

    bin_prot
    core
    monads
    ogre
    hike.hike_abi
    hike.hike_def_slot
    hike.hike_origin
    hike.hike_stack_bounds
    hike.hike_bir_flow
    hike.cbat_vsa
    hike.cbat_vsa_domain
    hike.hike_core
    hike.hike_emit))

; Build blocker: fails the build on env reads in src/ or direct prints
; outside Hike_diag / Event.Log. Runs on [dune build] and [@install].
(rule
 (alias all)
 (deps (source_tree .))
 (action
  (run %{workspace_root}/src/check_instrumentation.sh .)))

(rule
 (alias install)
 (deps (source_tree .))
 (action
  (run %{workspace_root}/src/check_instrumentation.sh .)))

; Dune-built bap plugin; installs where bap dynloads plugins from.
(plugin
 (name hike)
 (package hike)
 (libraries hike)
 (site (bap-common plugins)))
