; cbat_vsa_domain: CLP / abstract-value core. Unwrapped so that
; cbat_vsa (the BIR fixpoint library) can reference these modules
; unqualified — dune does not auto-open wrapped dependency libraries.
; cbat_vsa_utils lives here because cbat_clp and
; cbat_clp_set_composite depend on it (a cycle would result otherwise).
; The domain library links `bap`: Bap.Std is the only provider of the
; Word API used here.
;
; ppx is ppx_bap, which bundles the deriving set (bin_prot, sexp,
; compare, fields_conv) — the upstream 5-ppx split does not link
; under dune 3.23.

(library
 (name cbat_vsa_domain)
 (public_name hike.cbat_vsa_domain)
 (wrapped false)
 (ocamlopt_flags
  (:standard -O3))
 (modules
  cbat_clp
  cbat_clp_core
  cbat_clp_arith
  cbat_word
  cbat_fin_set
  cbat_lattice_intf
  cbat_map_lattice
  cbat_clp_set_composite
  cbat_wordset_intf
  cbat_vsa_utils
  cbat_var_id
  cbat_landmarks)
 (libraries hike_abi hike_origin hike_synth bap bitvec  bin_prot core monads )
 ; The cppo chain (mirrors src/dune and cbat_vsa): the VSA_DEBUG census
 ; blocks in cbat_clp.ml vanish from every non-vsa-debug build.
 (preprocess
  (action
   (run %{workspace_root}/src/cppo_preprocess.sh %{profile} %{input-file}))))

(library
 (name cbat_vsa)
 (public_name hike.cbat_vsa)
 (ocamlopt_flags
  (:standard -O3))
 (modules
  cbat_vsa
  cbat_transfer
  cbat_forward
  cbat_backward
  cbat_runctx
  cbat_wto
  cbat_dispatch_graph
  cbat_mem_key
  cbat_ai_memmap
  cbat_ai_representation
  cbat_call_effects
  cbat_kb_census
  cbat_attr_census
  cbat_env_tag
  cbat_def_origin
  cbat_vsa_stages)
 (libraries bap bap-knowledge hike_def_slot hike_abi hike_stack_bounds hike_bir_flow cbat_vsa_domain hike_synth bitvec core monads )
 ; The cppo chain (mirrors src/dune's hike library): the stages debug
 ; adapter carries #ifdef VSA_DEBUG, and without this stanza the raw
 ; directive reaches the parser — the trailing #ifdef then parses as a
 ; method call on the PRECEDING expression, surfacing far from the guard
 ; (the vsa-debug "not an object" breakage). cppo+ppx-jane replaces pps
 ; ppx_bap here (ppx-jane is the same Jane Street driver set, verified
 ; against every deriving clause in this library).
 (preprocess
  (action
   (run %{workspace_root}/src/cppo_preprocess.sh %{profile} %{input-file}))))

; THE PER-STAGE PROFILING ADAPTERS (the Q6 harness).
;
; [cbat_vsa_stages] is the ONE interface [cbat_vsa.ml] calls. Two adapters
; implement it, selected by profile and copied to that generated name:
;   - vsa-debug  -> cbat_vsa_stages_debug_src.ml  (times and accumulates)
;   - everything -> cbat_vsa_stages_prod.ml       (no-ops, erased)
; Production therefore pays nothing — no refs, no clock reads, no env
; lookups (AGENTS.md §6).
(rule
 (enabled_if (= %{profile} vsa-debug))
 (targets cbat_vsa_stages.ml)
 (action
  (copy cbat_vsa_stages_debug_src.ml cbat_vsa_stages.ml)))

(rule
 (enabled_if (<> %{profile} vsa-debug))
 (targets cbat_vsa_stages.ml)
 (action
  (copy cbat_vsa_stages_prod.ml cbat_vsa_stages.ml)))
